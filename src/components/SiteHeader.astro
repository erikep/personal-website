---
import { site } from "../data/site";

const pathname = Astro.url.pathname;

const links = [
  { href: "/work", label: "Work" },
  { href: "/education", label: "Education" },
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
] as const;

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${site.name} home`}>
      {site.name}
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={["site-header__link", { "is-active": isActive(link.href) }]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-rule) 70%, transparent);
    padding-top: env(safe-area-inset-top);
    animation: header-in var(--duration-med) var(--ease-out) both;
  }

  .site-header__inner {
    width: min(100% - 2 * var(--space-4), var(--width-wide));
    margin-inline: auto;
    min-height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    text-decoration: none;
    color: var(--color-ink);
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }

  .site-header__brand:hover {
    color: var(--color-accent);
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-2);
  }

  .site-header__link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink-muted);
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    display: inline-flex;
    align-items: center;
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: var(--color-ink);
  }

  .site-header__link.is-active {
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  @keyframes header-in {
    from {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 40rem) {
    .site-header__inner {
      width: min(100% - 2 * var(--space-5), var(--width-wide));
      gap: var(--space-5);
    }

    .site-header__nav {
      gap: var(--space-2) var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      animation: none;
    }
  }
</style>
