---
import { site } from "../data/site";

const socialEntries = (
  Object.entries(site.socials) as [keyof typeof site.socials, string][]
).map(([name, href]) => ({
  name,
  href,
  label: name === "github" ? "GitHub" : name === "linkedin" ? "LinkedIn" : name,
}));
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__contact">
      <p class="site-footer__label" id="footer-contact-label">Contact</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <div class="site-footer__socials">
      <p class="site-footer__label" id="footer-find-me-on-label">Find me on</p>
      <ul aria-labelledby="footer-find-me-on-label">
        {
          socialEntries.map(({ label, href }) => (
            <li>
              <a href={href} rel="me noopener noreferrer" target="_blank">
                {label}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="site-footer__meta">
      {site.location} · {site.school}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    padding-block: var(--space-6) calc(var(--space-7) + env(safe-area-inset-bottom));
  }

  .site-footer__inner {
    width: min(100% - 2 * var(--space-4), var(--width-wide));
    margin-inline: auto;
    display: grid;
    gap: var(--space-5);
  }

  .site-footer__label,
  .site-footer__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .site-footer__contact,
  .site-footer__socials {
    display: grid;
    gap: var(--space-2);
  }

  .site-footer__contact a,
  .site-footer__socials a {
    text-decoration: none;
    font-size: var(--text-sm);
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
  }

  .site-footer__contact a:hover,
  .site-footer__socials a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .site-footer__socials ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  @media (min-width: 40rem) {
    .site-footer__inner {
      width: min(100% - 2 * var(--space-5), var(--width-wide));
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .site-footer__meta {
      grid-column: 1 / -1;
    }
  }
</style>
