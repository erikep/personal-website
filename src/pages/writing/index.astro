---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/format";

const posts = (await getCollection("writing"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );
---

<BaseLayout
  title="Writing"
  description="Notes on engineering craft, developer tools, and building in public."
>
  <header class="page-head">
    <p class="eyebrow">Articles</p>
    <h1>Writing</h1>
    <p class="lede">
      Notes on personal journey, software engineering, and the systems that unblock personal productivity and economic activity.
    </p>
  </header>

  {
    posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-row" href={`/writing/${post.id}`}>
              <span class="post-row__main">
                <span class="post-row__title">{post.data.title}</span>
                <span class="post-row__summary">{post.data.description}</span>
              </span>
              <span class="post-row__aside">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatDate(post.data.publishedAt)}
                </time>
                {post.data.tags.length > 0 && (
                  <span>{post.data.tags.slice(0, 3).join(" · ")}</span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">
        No published posts yet. Add Markdown under{" "}
        <code>src/content/writing/</code> with <code>draft: false</code>.
      </p>
    )
  }
</BaseLayout>

<style>
  .page-head {
    display: grid;
    gap: var(--space-4);
    max-width: var(--width-content);
    margin-bottom: var(--space-8);
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .lede {
    margin: 0;
    color: var(--color-ink-muted);
    max-width: 48ch;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-rule);
  }

  .post-row {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .post-row:hover {
    background: color-mix(in srgb, var(--color-accent-soft) 35%, transparent);
  }

  .post-row__main {
    display: grid;
    gap: var(--space-2);
  }

  .post-row__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .post-row__summary {
    color: var(--color-ink-muted);
    max-width: 52ch;
  }

  .post-row__aside {
    display: grid;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    color: var(--color-ink-muted);
  }

  .empty code {
    font-size: 0.92em;
  }

  @media (min-width: 56rem) {
    .post-row {
      grid-template-columns: minmax(0, 1fr) 12rem;
      gap: var(--space-6);
      align-items: end;
    }

    .post-row__aside {
      text-align: right;
      justify-items: end;
    }
  }
</style>
