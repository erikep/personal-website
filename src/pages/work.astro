---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDateRange } from "../lib/format";
import "../styles/timeline.css";

const roles = (await getCollection("experience")).sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.startDate.valueOf() - a.data.startDate.valueOf();
});

const rendered = await Promise.all(
  roles.map(async (role) => ({
    role,
    Content: (await render(role)).Content,
  })),
);
---

<BaseLayout
  title="Work"
  description="Software engineering experience at Amazon and Polar Semiconductor."
>
  <header class="page-head">
    <p class="eyebrow">Experience</p>
    <h1>Work</h1>
    <p class="lede">
      Industry roles shaping how I view and build software, from product
      engineering to semiconductor testing.
    </p>
  </header>

  <ol class="timeline">
    {
      rendered.map(({ role, Content }) => (
        <li class="timeline__item">
          <div class="timeline__aside">
            <div class="timeline__meta">
              <time datetime={role.data.startDate.toISOString()}>
                {formatDateRange(
                  role.data.startDate,
                  role.data.endDate,
                  role.data.current,
                )}
              </time>
              {role.data.location && <span>{role.data.location}</span>}
              {role.data.current && <span class="timeline__now">Now</span>}
            </div>

            {role.data.image && (
              <figure class="timeline__media">
                <img
                  src={role.data.image.src}
                  alt={role.data.image.alt}
                  width="512"
                  height="512"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}
          </div>

          <div class="timeline__body">
            <h2>{role.data.company}</h2>
            <p class="timeline__role">{role.data.role}</p>
            {role.data.summary && (
              <p class="timeline__summary">{role.data.summary}</p>
            )}

            {role.data.bullets.length > 0 && (
              <ul class="timeline__bullets">
                {role.data.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}

            {role.data.stack.length > 0 && (
              <ul class="timeline__stack">
                {role.data.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}

            <div class="timeline__notes">
              <Content />
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</BaseLayout>
