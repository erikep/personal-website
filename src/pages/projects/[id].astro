---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/format";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const linkEntries = (
  [
    ["GitHub", project.data.links.github],
    ["Live", project.data.links.live],
    ["Demo", project.data.links.demo],
  ] as const
).filter((entry): entry is [string, string] => Boolean(entry[1]));
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  ogType="article"
>
  <article class="project">
    <p class="eyebrow">
      <a href="/projects">Projects</a>
      <span aria-hidden="true">/</span>
      <time datetime={project.data.publishedAt.toISOString()}>
        {formatDate(project.data.publishedAt)}
      </time>
      {
        project.data.featured && (
          <>
            <span aria-hidden="true">/</span>
            <span class="featured">Featured</span>
          </>
        )
      }
    </p>

    <header class="project__header">
      <h1>{project.data.title}</h1>
      <p class="summary">{project.data.summary}</p>
      {
        project.data.tags.length > 0 && (
          <ul class="tags">
            {project.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      {
        linkEntries.length > 0 && (
          <p class="links">
            {linkEntries.map(([label, href]) => (
              <a href={href} target="_blank" rel="noopener noreferrer">
                {label}
              </a>
            ))}
          </p>
        )
      }
    </header>

    <div class="body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    display: grid;
    gap: var(--space-6);
    max-width: var(--measure);
  }

  .eyebrow {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .eyebrow a {
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--color-accent);
  }

  .featured {
    color: var(--color-accent);
  }

  .project__header {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-rule);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .summary {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    color: var(--color-accent);
  }

  .body :global(h2) {
    margin: var(--space-6) 0 var(--space-3);
    font-size: var(--text-xl);
  }

  .body :global(h3) {
    margin: var(--space-5) 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin-block: 0 var(--space-4);
  }

  .body :global(ul),
  .body :global(ol) {
    padding-left: 1.15rem;
  }

  .body :global(li + li) {
    margin-top: var(--space-2);
  }

  .body :global(a) {
    color: var(--color-accent);
  }
</style>
