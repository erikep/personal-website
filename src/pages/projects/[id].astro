---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/format";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="project">
    <p class="eyebrow">
      <a href="/projects">Projects</a>
      <span aria-hidden="true">/</span>
      <time datetime={project.data.publishedAt.toISOString()}>
        {formatDate(project.data.publishedAt)}
      </time>
    </p>
    <h1>{project.data.title}</h1>
    <p class="summary">{project.data.summary}</p>
    {
      project.data.tags.length > 0 && (
        <ul class="tags">
          {project.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    {
      (project.data.links.github ||
        project.data.links.live ||
        project.data.links.demo) && (
        <p class="links">
          {project.data.links.github && (
            <a
              href={project.data.links.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          )}
          {project.data.links.live && (
            <a
              href={project.data.links.live}
              target="_blank"
              rel="noopener noreferrer"
            >
              Live
            </a>
          )}
          {project.data.links.demo && (
            <a
              href={project.data.links.demo}
              target="_blank"
              rel="noopener noreferrer"
            >
              Demo
            </a>
          )}
        </p>
      )
    }
    <div class="body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .eyebrow {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .eyebrow a {
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--color-accent);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .summary {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin: 0;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    color: var(--color-accent);
  }

  .body {
    padding-top: var(--space-2);
  }

  .body :global(p) {
    margin-block: 0 var(--space-4);
  }
</style>
