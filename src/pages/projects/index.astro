---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Projects"
  description="Selected full-stack work across developer tools and productivity software."
>
  <section class="page-stub">
    <p class="eyebrow">Portfolio</p>
    <h1>Projects</h1>
    <p class="lede">
      Project index and case studies land in the next implementation step.
    </p>
  </section>
</BaseLayout>

<style>
  .page-stub {
    display: grid;
    gap: var(--space-4);
    max-width: var(--width-content);
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .lede {
    color: var(--color-ink-muted);
  }
</style>
